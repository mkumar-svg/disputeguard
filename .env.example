# Copy to .env and fill in. Never commit .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_SKIP_WEBHOOK_VERIFICATION=false
PORT=8081

# LLM for the dispute agent (any OpenAI-compatible endpoint with tool calling).
# Leave LLM_API_KEY empty to run without AI: evidence packs are then built from rules only.
#
# Claude (Anthropic API key from console.anthropic.com):
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-sonnet-5-5
#
# Gemini (free key from aistudio.google.com), use these two lines instead:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# Optional: a second model on the same endpoint, tried when the main one is busy (429/503).
LLM_FALLBACK_MODEL=
